FROM postgres:17-alpine
LABEL org.opencontainers.image.source="https://github.com/Hubertoink/flow"
RUN apk add --no-cache dcron tzdata
ENV TZ=Europe/Berlin
COPY scripts/database-backup.sh /usr/local/bin/flow-database-backup
COPY scripts/backup-entrypoint.sh /usr/local/bin/flow-backup-start
RUN chmod 755 /usr/local/bin/flow-database-backup /usr/local/bin/flow-backup-start && printf '0 3 * * * /usr/local/bin/flow-database-backup\n' > /etc/crontabs/root
ENTRYPOINT ["/usr/local/bin/flow-backup-start"]
