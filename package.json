{
  "name": "flow-jugendplan",
  "private": true,
  "version": "1.8.8",
  "description": "Flow! - Lokale Wochen- und Einsatzplanung",
  "author": "Hubertoink",
  "homepage": "https://github.com/Hubertoink/flow",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node preview.mjs",
    "check": "node --check dist/icons.js && node --check dist/app.js && node --check dist/canvas.js && node --check dist/projects.js && node --check dist/exports.js && node --check desktop/main.cjs && node --check desktop/preload.cjs",
    "test": "node canvas.test.mjs && node exports.test.mjs && node packaging.test.mjs",
    "vendor": "node vendor-exports.mjs",
    "desktop": "electron .",
    "test:desktop": "node desktop.test.mjs",
    "dist:win": "npm run vendor && npm run check && npm test && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run vendor && npm run check && npm test && electron-builder --linux AppImage --x64 --publish never && node package-linux.mjs",
    "icons": "node generate-icons.mjs",
    "team": "node server/main.mjs",
    "team:local": "node scripts/start-local.mjs",
    "team:stop": "docker compose --env-file .flow-local/config.env -f compose.dev.yml -f compose.local.yml stop",
    "test:team": "node --env-file=.flow-local/config.env team.test.mjs",
    "check:team": "node scripts/check-team.mjs"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    }
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "exceljs": "4.4.0",
    "html-to-image": "1.11.13",
    "jsdom": "29.1.1",
    "lucide-static": "1.56.0",
    "playwright-core": "1.64.0"
  },
  "build": {
    "appId": "com.hubertoink.flow",
    "productName": "Flow!",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "Hubertoink",
        "repo": "flow",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/Flow__Logo.ico",
      "artifactName": "Flow-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/Flow__Logo.ico",
      "uninstallerIcon": "assets/Flow__Logo.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "executableName": "flow-jugendplan",
      "icon": "assets/Flow!_Logo.png",
      "category": "Office",
      "artifactName": "Flow-${version}-x86_64-linux.${ext}"
    }
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "electron-updater": "6.8.9",
    "express": "5.3.0",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}
