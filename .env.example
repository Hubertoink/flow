# Production: replace every value below. Keep .env out of Git.
FLOW_IMAGE=ghcr.io/YOUR-ACCOUNT/flow:VERSION
FLOW_BACKUP_IMAGE=ghcr.io/YOUR-ACCOUNT/flow-backup:VERSION
FLOW_URL=https://flow.example.org
# Generate independent random secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FLOW_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
FLOW_SETUP_TOKEN=REPLACE_WITH_RANDOM_SETUP_TOKEN
FLOW_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
FLOW_TRUST_PROXY=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Flow! <flow@example.org>
